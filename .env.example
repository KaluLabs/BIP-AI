# BIP-AI local state
BIP_AI_DB=.bipai/bip-ai.sqlite
BIP_AI_EVENT_DIR=.bipai/events
BIP_AI_PROJECTS=.bipai/projects.json
BIP_AI_STORY_THRESHOLD=3

# Automatic local Git capture. Enabled by default.
BIP_AI_CAPTURE_ENABLED=1
BIP_AI_CAPTURE_POLL_MS=60000
BIP_AI_CAPTURE_BATCH_SIZE=50
BIP_AI_CAPTURE_RETRY_BASE_MS=5000
BIP_AI_CAPTURE_RETRY_MAX_MS=300000

# Optional GitHub activity capture for projects that configure an owner/repo source.
# Token stays in the environment and is never persisted into project/capture/event state.
BIP_AI_GITHUB_TOKEN=
BIP_AI_GITHUB_API_BASE_URL=https://api.github.com
BIP_AI_GITHUB_POLL_MS=300000

# Local Control Room. Remote binding is refused unless BIP_AI_ALLOW_REMOTE=1.
BIP_AI_HOST=127.0.0.1
BIP_AI_PORT=8790
BIP_AI_ALLOW_REMOTE=0
# Due editorial schedules are checked every 30 seconds when PAG is configured.
BIP_AI_SCHEDULE_POLL_MS=30000

# Drafting provider. Default is deterministic and needs no API key.
BIP_AI_DRAFT_PROVIDER=deterministic
BIP_AI_DRAFT_BASE_URL=
BIP_AI_DRAFT_API_KEY=
BIP_AI_DRAFT_MODEL=

# Personal Access Gateway
PAG_BASE_URL=http://127.0.0.1:8787
PAG_ACTOR_TOKEN=

# Optional PAG connection IDs. These are metadata IDs, not credentials.
BIP_AI_X_CONNECTION_ID=
BIP_AI_LINKEDIN_CONNECTION_ID=
