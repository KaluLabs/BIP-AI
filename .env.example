# BIP-AI local state
BIP_AI_DB=.bipai/bip-ai.sqlite
BIP_AI_EVENT_DIR=.bipai/events
BIP_AI_PROJECTS=.bipai/projects.json
BIP_AI_STORY_THRESHOLD=3

# Drafting provider. Default is deterministic and needs no API key.
BIP_AI_DRAFT_PROVIDER=deterministic
BIP_AI_DRAFT_BASE_URL=
BIP_AI_DRAFT_API_KEY=
BIP_AI_DRAFT_MODEL=

# Personal Access Gateway
PAG_BASE_URL=http://127.0.0.1:8787
PAG_ACTOR_TOKEN=

# Optional PAG connection IDs. These are metadata IDs, not credentials.
BIP_AI_X_CONNECTION_ID=
BIP_AI_LINKEDIN_CONNECTION_ID=
